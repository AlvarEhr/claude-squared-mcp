{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__(?:pair|Claude_Squared)__(?:pair_send|pair_send_async|pair_compact|pair_create|pair_invoke|pair_handoff)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"/absolute/path/to/.claude/pairs/auto_watch.py\"",
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ]
  }
}
